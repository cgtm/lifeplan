# tests/e2e/.env — local secrets for the Probe e2e suite.
#
# This file is gitignored. Copy to `.env` (or run `./setup.sh`) and fill in
# the live values. The Playwright config loads this automatically at startup.
#
# Cam writes this once. The team reads it forever.

# REQUIRED — the current local-dev login password (the one set via
# `python3 -m app.auth set-password`). Probe needs it to drive the auth flow.
LIFEPLAN_TEST_PASSWORD=replace-me

# OPTIONAL — overrides the default base URL (http://localhost:3131/).
# Use https://your-domain.example/lifeplan/ for an ad-hoc production verification run.
# LIFEPLAN_TEST_BASE_URL=http://localhost:3131/

# OPTIONAL — set to "1" to run the rate-limit test (5x wrong-password →
# 429). Off by default because it burns the in-process limiter slots and
# means the next run needs a server restart. Run on demand only.
# RATE_LIMIT_TEST=1

# OPTIONAL — only consulted when RATE_LIMIT_TEST=1. Shell command the
# fixture runs in globalSetup to clear the in-process limiter before the
# rate-limit test executes.
# LIFEPLAN_RESTART_CMD=/Users/cam/dev/personal/lifeplan/lp restart
