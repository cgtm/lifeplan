{
  "name": "lifeplan-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end verification suite for Lifeplan. Owned by Probe.",
  "scripts": {
    "setup": "./setup.sh",
    "test": "playwright test --grep @smoke",
    "smoke": "playwright test --grep @smoke",
    "gate": "playwright test",
    "full": "playwright test",
    "auth": "playwright test --grep @auth",
    "tags": "playwright test --grep @tags",
    "blocker": "playwright test --grep \"@blockers|@goal\"",
    "dump": "playwright test --grep \"@dump|@worker\"",
    "add": "playwright test --grep \"@people|@knowledge\"",
    "test:headed": "playwright test --headed",
    "test:webkit-only": "playwright test --project=webkit",
    "test:chromium-only": "playwright test --project=chromium",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "install-browsers": "playwright install"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "dotenv": "^16.4.5"
  }
}
