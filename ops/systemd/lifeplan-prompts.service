[Unit]
Description=lifeplan daily prompt generation
After=network.target

[Service]
Type=oneshot
User=your-user
Group=your-user
WorkingDirectory=/opt/lifeplan
ExecStart=/usr/bin/python3 -m app.generate_prompts
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lifeplan-prompts

# Hardening (mirrors lifeplan.service)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/lifeplan/data
PrivateTmp=yes
