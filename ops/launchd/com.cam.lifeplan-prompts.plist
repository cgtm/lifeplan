<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cam.lifeplan-prompts</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/opt/python@3.12/bin/python3.12</string>
        <string>-m</string>
        <string>app.generate_prompts</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/cam/dev/personal/lifeplan</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/cam/dev/personal/lifeplan/data/prompts.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/cam/dev/personal/lifeplan/data/prompts.log</string>
</dict>
</plist>
